# Sólo para apuntar a otra API; en local Vite proxea /api a http://localhost:5000.
VITE_API_URL=
# Opt-in para bundles optimizados de staging/preview. Nunca habilitar en producción.
VITE_DEVELOPMENT_AUTH_ENABLED=false
# Ingreso con Microsoft. En local requiere el backend con AutenticacionMicrosoft habilitado.
VITE_MICROSOFT_LOGIN_ENABLED=false
