# .env.example — variables y secrets del proyecto. SIN valores reales.
#
# - Desarrollo local: copiar a `.env` y ajustar (lo consume docker-compose.yml).
# - Deploy / CI: los valores reales NO van acá ni al repo; se inyectan como
#   GitHub Actions secrets en runtime (ver infra/README.md y los workflows).

# =====================================================================
# Desarrollo local (docker-compose.yml — instancia Postgres local)
# =====================================================================
POSTGRES_DB=arsdocendi
POSTGRES_USER=arsdocendi
POSTGRES_PASSWORD=changeme

# =====================================================================
# Deploy de ambientes (prod / staging / pr-N) — ver infra/
# =====================================================================
# Dominio público real (reemplaza el placeholder example.net). No se versiona.
DOMINIO=example.net

# Registro de imágenes y tags determinísticos por SHA (los pone CI).
REGISTRO=ghcr.io/ars-docendi
TAG_FRONTEND=sha-abc1234
TAG_BACKEND=sha-abc1234

# --- Postgres ADMIN (credenciales libpq para CREATE/DROP DATABASE) ---
# Distintas del usuario de la app. SECRET en CI.
PGHOST=arsdocendi-postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=__SECRET_RUNTIME__

# --- Rol de la app por ambiente (lo crea provision-db.sh) ---
APP_DB_USER=app_pr_123
APP_DB_PASSWORD=__SECRET_RUNTIME__

# --- Runtime backend ---
ASPNETCORE_ENVIRONMENT=Production
DEVELOPMENT_AUTHENTICATION_ENABLED=false
# Comando de migraciones EF que corre spin-up (la app debe soportar el arg).
COMANDO_MIGRACIONES=dotnet ArsDocendi.Host.dll --migrate

# =====================================================================
# Secrets de infra (GitHub Actions secrets — NUNCA en el repo ni en imágenes)
# =====================================================================
# Cloudflare Tunnel: token o credentials.json del túnel (ver infra/cloudflared/).
CLOUDFLARE_TUNNEL_TOKEN=__SECRET_RUNTIME__
# Nota: el login a ghcr.io lo hacen los workflows con el GITHUB_TOKEN del run
# (permissions: packages: write) — no requiere secrets de registry. Si en el
# futuro se usa un registro externo (Docker Hub, registry interno), agregar acá
# REGISTRY_USUARIO / REGISTRY_TOKEN y restaurar el login con esos valores.

# =====================================================================
# Runners efímeros (infra/runners/) — secret del HOST, no de Actions.
# Va en /etc/ars-docendi/runner.env (600), lo usa respawn-efimero.sh para
# pedir registration-tokens a la API de GitHub. Ver infra/README.md §4.
# =====================================================================
GH_OWNER=Ars-Docendi
GH_REPO=__NOMBRE_REPO__
# PAT fine-grained con "Administration: Read and write" sobre el repo
# (o token de instalación de una GitHub App). NUNCA al repo.
GH_PAT=__SECRET_RUNTIME__
RUNNER_LABELS=arsdocendi,efimero

# =====================================================================
# Reaper (infra/reaper/) — limpieza de ambientes pr-N huérfanos
# =====================================================================
# Antigüedad máxima (días) de un pr-N antes de que el reaper lo destruya.
REAPER_MAX_DIAS=7
