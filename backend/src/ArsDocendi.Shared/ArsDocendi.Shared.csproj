<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
  </ItemGroup>

  <!--
    El DDL de los schemas `audit` e `identity` se autora en SQL versionado bajo
    database/ (fuente autorizada) y se embebe acá como recurso del assembly.
    Las migraciones EF lo ejecutan con migrationBuilder.Sql(...), de modo que el
    deploy no depende de que el directorio database/ viaje en la imagen.
    Ver openspec/changes/modelo-datos-identity-designaciones/design.md (D8).
  -->
  <ItemGroup>
    <SqlAudit Include="$(MSBuildThisFileDirectory)..\..\..\database\audit\*.sql" />
    <SqlIdentity Include="$(MSBuildThisFileDirectory)..\..\..\database\identity\*.sql" />
    <EmbeddedResource Include="@(SqlAudit)" Link="Sql\audit\%(Filename)%(Extension)" />
    <EmbeddedResource Include="@(SqlIdentity)" Link="Sql\identity\%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Un glob de MSBuild que no matchea nada NO es un error: compila un assembly sin
    recursos y el fallo recién aparece al correr las migraciones. Pasó exactamente
    eso — el build context de Docker era `backend/`, `database/` quedaba afuera, y
    el deploy explotó con "0 recursos disponibles". Fallar acá convierte un error
    de deploy en un error de compilación.
  -->
  <Target Name="ValidarSqlEmbebido" BeforeTargets="BeforeBuild">
    <Error Condition="'@(SqlAudit)' == ''"
           Text="No se encontró ningún .sql en database/audit/. El DDL se embebe como recurso de este assembly, así que sin esos archivos las migraciones fallan en runtime. Verificá que el build context incluya el directorio database/ de la raíz del repo." />
    <Error Condition="'@(SqlIdentity)' == ''"
           Text="No se encontró ningún .sql en database/identity/. El DDL se embebe como recurso de este assembly, así que sin esos archivos las migraciones fallan en runtime. Verificá que el build context incluya el directorio database/ de la raíz del repo." />
  </Target>

</Project>
