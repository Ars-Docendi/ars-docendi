<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
  </ItemGroup>

  <!--
    El DDL de los schemas `audit` e `identity` se autora en SQL versionado bajo
    database/ (fuente autorizada) y se embebe acá como recurso del assembly.
    Las migraciones EF lo ejecutan con migrationBuilder.Sql(...), de modo que el
    deploy no depende de que el directorio database/ viaje en la imagen.
    Ver openspec/changes/modelo-datos-identity-designaciones/design.md (D8).
  -->
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\..\database\audit\*.sql"
                      Link="Sql\audit\%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\..\database\identity\*.sql"
                      Link="Sql\identity\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
