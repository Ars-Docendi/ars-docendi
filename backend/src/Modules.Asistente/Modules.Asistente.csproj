<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <!--
    Referencia única a ArsDocendi.Shared. El módulo NO referencia todavía su
    propio .Contracts (que nace vacío, ver Modules.Asistente.Contracts/README.md)
    ni ningún otro módulo: los edges hacia Contracts ajenos llegan con el carril
    determinista de API.

    Npgsql va sin EF Core: el módulo no tiene entidades ni DbContext. Lo único
    que necesita hoy es abrir una conexión para aplicar sus GRANT, y más adelante
    para ejecutar la consulta generada con las conexiones de solo lectura.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ArsDocendi.Shared\ArsDocendi.Shared.csproj" />
  </ItemGroup>

  <!--
    DDL del asistente, autorado en SQL versionado bajo database/ y embebido acá
    como recurso. Lo ejecuta MigradorAsistente; ver la nota equivalente en
    Modules.Designaciones.csproj.
  -->
  <!--
    Catálogo de ejemplos pregunta-SQL. Embebido para que viaje con el assembly:
    leerlo del disco haría que el módulo dependiera del layout del despliegue.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Recursos\ejemplos-sql.json" />
  </ItemGroup>

  <ItemGroup>
    <SqlAsistente Include="$(MSBuildThisFileDirectory)..\..\..\database\asistente\*.sql" />
    <EmbeddedResource Include="@(SqlAsistente)" Link="Sql\asistente\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Un glob vacío compila en silencio y el fallo aparece recién al migrar. -->
  <Target Name="ValidarSqlEmbebido" BeforeTargets="BeforeBuild">
    <Error Condition="'@(SqlAsistente)' == ''"
           Text="No se encontró ningún .sql en database/asistente/. El DDL se embebe como recurso de este assembly, así que sin esos archivos los privilegios del asistente no se aplican. Verificá que el build context incluya el directorio database/ de la raíz del repo." />
  </Target>

</Project>
