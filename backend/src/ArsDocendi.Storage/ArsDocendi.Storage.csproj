<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArsDocendi.Shared\ArsDocendi.Shared.csproj" />
    <ProjectReference Include="..\ArsDocendi.Storage.Contracts\ArsDocendi.Storage.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <SqlStorage Include="$(MSBuildThisFileDirectory)..\..\..\database\storage\*.sql" />
    <EmbeddedResource Include="@(SqlStorage)" Link="Sql\storage\%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="ValidarSqlEmbebido" BeforeTargets="BeforeBuild">
    <Error Condition="'@(SqlStorage)' == ''" Text="No se encontró ningún .sql en database/storage/." />
  </Target>
</Project>
