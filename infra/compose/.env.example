# Variables de UN ambiente Ars Docendi (frontend + backend).
#
# Este archivo documenta las variables que consume compose.base.yml.
# NO contiene valores reales ni secretos. El .env real de cada ambiente se
# genera en runtime (por spin-up.sh o por el workflow de CI) y NUNCA se commitea.
#
# Uso:
#   docker compose -p <AMBIENTE> --env-file <env-del-ambiente> -f compose.base.yml up -d
#
# --- Identidad del ambiente ---
AMBIENTE=pr-123
HOST_PUBLICO=pr-123.example.net

# --- Imágenes ---
REGISTRO=ghcr.io/ars-docendi
TAG_FRONTEND=sha-abc1234
TAG_BACKEND=sha-abc1234

# --- Runtime del backend ---
ASPNETCORE_ENVIRONMENT=Production
DEVELOPMENT_AUTHENTICATION_ENABLED=false
URL_BASE_DATOS=Host=arsdocendi-postgres;Port=5432;Database=arsdocendi_pr_123;Username=app_pr_123;Password=__INYECTAR_EN_RUNTIME__

# --- Almacenamiento privado SeaweedFS ---
# El servicio S3 y ClamAV usan aliases internos únicos por ambiente; no se
# publican en Traefik ni en Cloudflare.
ALMACENAMIENTO_ENDPOINT=seaweedfs-pr-123:8333
ALMACENAMIENTO_ACCESS_KEY=__INYECTAR_EN_RUNTIME__
ALMACENAMIENTO_SECRET_KEY=__INYECTAR_EN_RUNTIME__
ALMACENAMIENTO_BUCKET=arsdocendi-pr-123
ALMACENAMIENTO_USE_SSL=false
ALMACENAMIENTO_CLAMAV_HOST=clamav-pr-123
ALMACENAMIENTO_CLAMAV_PORT=3310
ALMACENAMIENTO_RECHAZAR_SI_ANTIVIRUS_NO_DISPONIBLE=true

# --- Provisionamiento de SeaweedFS (solo scripts de infra/CI) ---
SEAWEEDFS_IMAGE=chrislusf/seaweedfs@sha256:ce9e796f1fe6f06968f4c04bdaf8f678dad9c8acdfef3d244133d71bfa6bf882
SEAWEEDFS_HOSTNAME=seaweedfs-pr-123
CLAMAV_HOSTNAME=clamav-pr-123
STORAGE_SUFFIX=pr_123
RED_DATOS=arsdocendi-datos
SEAWEEDFS_ROOT_ACCESS_KEY=__INYECTAR_EN_RUNTIME__
SEAWEEDFS_ROOT_SECRET_KEY=__INYECTAR_EN_RUNTIME__
SEAWEEDFS_APP_ACCESS_KEY=__INYECTAR_EN_RUNTIME__
SEAWEEDFS_APP_SECRET_KEY=__INYECTAR_EN_RUNTIME__
SEAWEEDFS_BUCKET=arsdocendi-pr-123
SEAWEEDFS_APP_ACCESS_KEY_PR_123=__INYECTAR_EN_RUNTIME__
SEAWEEDFS_APP_SECRET_KEY_PR_123=__INYECTAR_EN_RUNTIME__
