# Variables de UN ambiente Ars Docendi (frontend + backend).
#
# Este archivo documenta TODAS las variables que consume compose.base.yml.
# NO contiene valores reales ni secretos. El .env real de cada ambiente se
# genera en runtime (por spin-up.sh o por el workflow de CI) y NUNCA se commitea.
#
# Uso:
#   docker compose -p <AMBIENTE> --env-file <env-del-ambiente> -f compose.base.yml up -d
#
# Equivalencia con los nombres "ilustrativos" de las tasks del change:
#   AMBIENTE       <- ENV_NAME
#   HOST_PUBLICO   <- HOSTNAME   (renombrado: ${HOSTNAME} colisiona con la shell)
#   TAG_FRONTEND   <- IMAGE_TAG_FRONTEND
#   TAG_BACKEND    <- IMAGE_TAG_BACKEND
#   URL_BASE_DATOS <- DB_URL

# --- Identidad del ambiente ---
# Nombre del Compose project y del ambiente. Determinístico: prod | staging | pr-<N>.
AMBIENTE=pr-123

# Hostname público del ambiente. Resulta de <AMBIENTE>.<DOMINIO>.
# El DOMINIO real vive solo en runtime/runbook; en el repo se usa example.net.
HOST_PUBLICO=pr-123.example.net

# --- Imágenes (pre-buildeadas y taggeadas por SHA en CI) ---
# Registro/namespace donde viven las imágenes (ghcr.io/<org>, registry interno, etc.).
REGISTRO=ghcr.io/ars-docendi
# Tags determinísticos por SHA del commit deployado.
TAG_FRONTEND=sha-abc1234
TAG_BACKEND=sha-abc1234

# --- Runtime del backend ---
ASPNETCORE_ENVIRONMENT=Production
DEVELOPMENT_AUTHENTICATION_ENABLED=false
# Connection string a la base AISLADA del ambiente (D7: una base por ambiente).
# La base se llama arsdocendi_<AMBIENTE normalizado>, p. ej. arsdocendi_pr_123.
# El usuario/host/password reales se inyectan en runtime, nunca acá.
URL_BASE_DATOS=Host=arsdocendi-postgres;Port=5432;Database=arsdocendi_pr_123;Username=app_pr_123;Password=__INYECTAR_EN_RUNTIME__

# --- Almacenamiento privado ---
# El servicio MinIO no se publica en Traefik ni en Cloudflare. Estas credenciales
# se inyectan desde CI/secret manager; los placeholders no son valores válidos.
ALMACENAMIENTO_ENDPOINT=minio:9000
ALMACENAMIENTO_ACCESS_KEY=__INYECTAR_EN_RUNTIME__
ALMACENAMIENTO_SECRET_KEY=__INYECTAR_EN_RUNTIME__
ALMACENAMIENTO_BUCKET=arsdocendi_pr_123
MINIO_ROOT_USER=__INYECTAR_EN_RUNTIME__
MINIO_ROOT_PASSWORD=__INYECTAR_EN_RUNTIME__
# Las credenciales de aplicación se derivan en runtime desde MINIO_ROOT_PASSWORD
# y AMBIENTE para prod/staging; pr-N genera una credencial efímera por PR.
