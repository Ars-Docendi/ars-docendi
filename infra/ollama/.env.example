# Configuración propia de Ollama: copiar fuera de Git y ejecutar en pc-prod.
# Se reutiliza Traefik existente; no hay imagen/proceso Nginx adicional.
OLLAMA_IMAGEN=ollama/ollama@sha256:2a6e883b917fc543389599dae79918f5cac9e1438890506982f44aa4f5625d01

# Red externa privada, creada por operador; Traefik debe estar conectado.
OLLAMA_RED_TRAEFIK=docendi-ai-inferencia
# Aumentar después de cada alta/rotación/baja y recrear sólo Ollama.
# No es una contraseña: cambia realm para releer usersFile en Traefik.
OLLAMA_AUTH_REVISION=1
# Sólo documentación/operación: archivo host fuera de Git, en carpeta privada.
# Traefik monta ESA CARPETA en /etc/traefik/ollama-auth:ro, no el archivo solo.
# El nombre dentro de la carpeta debe ser htpasswd; UID/permisos permiten lectura.
OLLAMA_ARCHIVO_AUTH=/RUTA/PRIVADA/ollama/htpasswd

# Límites globales, no prioridad/reserva GPU por ambiente ni límite de VRAM.
OLLAMA_LIMITE_CPU=2
OLLAMA_LIMITE_MEMORIA=8g
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MAX_QUEUE=4
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_KEEP_ALIVE=5m

# Sólo comandos del operador: validar modelo local/licencia/recursos.
OLLAMA_MODELO=qwen3:4b
