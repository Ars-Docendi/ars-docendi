# Copiar fuera del repo a /etc/arsdocendi/audit-seal.env y proteger con chmod 600.
# El deploy-prod etiqueta localmente la imagen backend como audit-seal-prod.
REGISTRO=ghcr.io/ars-docendi
AUDIT_SEAL_ENVIRONMENT=prod
AUDIT_SEAL_MAX_EVENTS=1000
AUDIT_SEAL_CONNECTION_STRING=Host=<postgres-interno>;Port=5432;Database=arsdocendi_prod;Username=audit_sealer;Password=<inyectar-desde-gestor-de-secretos>
AUDIT_SEAL_SIGNER_URL=https://<servicio-firma-independiente>/v1/sign
AUDIT_SEAL_SIGNER_TOKEN=<inyectar-desde-gestor-de-secretos>
AUDIT_SEAL_WITNESS_PRIMARY_URL=https://<custodio-primario-independiente>/v1/manifests
AUDIT_SEAL_WITNESS_PRIMARY_TOKEN=<credencial-distinta>
AUDIT_SEAL_WITNESS_SECONDARY_URL=https://<testigo-secundario-independiente>/v1/hashes
AUDIT_SEAL_WITNESS_SECONDARY_TOKEN=<credencial-distinta>
# Lectura GET /latest independiente. 404 sólo significa génesis si AMBOS responden 404;
# 5xx, timeout, retroceso o discrepancia detienen el job antes de publicar.
AUDIT_SEAL_WITNESS_PRIMARY_READ_URL=https://<custodio-primario-independiente>/v1/latest
AUDIT_SEAL_WITNESS_PRIMARY_READ_TOKEN=<credencial-lectora-distinta>
AUDIT_SEAL_WITNESS_SECONDARY_READ_URL=https://<testigo-secundario-independiente>/v1/latest
AUDIT_SEAL_WITNESS_SECONDARY_READ_TOKEN=<credencial-lectora-distinta>
# JSON con ID→PEM público fijado por operaciones; escapes JSON para saltos de línea.
AUDIT_SEAL_PUBLIC_KEYS_JSON={"<id-clave>":"<pem-publico>"}
AUDIT_SEAL_KEY_TRANSITIONS_JSON=[]
